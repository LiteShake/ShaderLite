# ============================================================
# ShaderLite — .gitignore
# ============================================================

# ---- OS / System ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Editors / IDEs ----
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.code-workspace
*.swp
*.swo
*~

# ---- Minecraft / Local test artifacts ----
# If you symlink or test inside .minecraft/, ignore the logs
logs/
crash-reports/
*.log
options.txt
servers.dat

# ---- Build / Distribution ----
# The compiled .zip you drop into shaderpacks/ doesn't need to be tracked
*.zip
!shaderpacks/.gitkeep

# ---- Misc ----
*.bak
*.tmp
*.cache